[Unit]
Description=Spicy auto-fix worker
After=network-online.target

[Service]
Environment=PATH=/home/home/.local/node/bin:/home/home/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/home/.local/node/bin/node /srv/spicy/repo/ops/autofix/worker.mjs
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
