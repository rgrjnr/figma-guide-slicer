# Copy to .env.local (gitignored) and fill in. Never commit real values.

# Your Braze dashboard, e.g. https://dashboard-01.braze.com
BRAZE_URL=

# The Okta identity you sign in with.
BRAZE_EMAIL=
BRAZE_PASSWORD=

# The base32 secret behind your Okta authenticator entry — the string you would
# have typed into an authenticator app instead of scanning the QR code. If you
# only ever scanned the QR, re-enrol the factor and choose "can't scan" to see it.
BRAZE_TOTP_SECRET=

# Set to 1 to hide the browser. Leave unset while a flow is still being trusted.
BRAZE_HEADLESS=
# Milliseconds of delay between actions, for watching a run in slow motion.
BRAZE_SLOWMO=
