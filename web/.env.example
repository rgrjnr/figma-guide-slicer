# Copy to .env.local (gitignored) and fill in. Never commit real values.

# Your Braze dashboard, e.g. https://dashboard-01.braze.com
BRAZE_URL=

# Your Okta org — only needed if you reach Braze by signing into the Okta portal
# and clicking its tile, rather than by starting at Braze. Set both and the
# robot tries Braze first.
#
# Note WBD has two Okta domains: ssobiz.wbd.com is the IdP that Braze hands off
# to (per the SAML AuthnRequest), and wmbiz.okta.com is the end-user app portal.
# Neither ends in okta.com in the case of the first, which is why the flow finds
# Okta by its sign-in widget rather than by hostname.
BRAZE_OKTA_URL=
# The tile's name on the Okta dashboard, if it is not simply "Braze".
BRAZE_APP_TILE=
# Braze asks which identity provider to use before handing off; this matches the
# button by name. "Okta" matches WBD's "WBD Okta" button.
BRAZE_SSO_BUTTON=

# The Okta identity you sign in with.
BRAZE_EMAIL=
BRAZE_PASSWORD=

# The base32 secret behind your Okta authenticator entry — the string you would
# have typed into an authenticator app instead of scanning the QR code. If you
# only ever scanned the QR, re-enrol the factor and choose "can't scan" to see it.
BRAZE_TOTP_SECRET=

# Set to 1 to hide the browser. Leave unset while a flow is still being trusted.
BRAZE_HEADLESS=
# Milliseconds of delay between actions, for watching a run in slow motion.
BRAZE_SLOWMO=

# Workspace scope for dashboard URLs. Discovered automatically if left blank.
BRAZE_APP_GROUP=

# Braze's schedule step has NO time-zone control: a designated time is read in
# the workspace's own zone, the one shown in the dashboard header. The flow
# converts your requested zone into this one before typing the time in, so this
# must match the workspace or every send lands hours out.
BRAZE_WORKSPACE_TZ=America/New_York
